#!/usr/bin/env python3
"""Standalone CLI: read a skill-usage.log and print a Markdown curator report.

Usage:
    skills-curator [--log PATH] [--skills-dir PATH] [--plugins-dir PATH]

Defaults:
    --log          ~/.claude/skill-usage.log
    --skills-dir   ~/.claude/skills
    --plugins-dir  ~/.claude/plugins

The output is the same Markdown table the `/skills-curator` skill produces.
This lets you regenerate the report without invoking the skill itself — handy
for cron jobs or CI checks.
"""
from __future__ import annotations

import argparse
import os
import re
import sys
from collections import Counter, defaultdict
from datetime import datetime, timezone
from pathlib import Path

DEFAULT_LOG = Path.home() / ".claude" / "skill-usage.log"
DEFAULT_SKILLS = Path.home() / ".claude" / "skills"
DEFAULT_PLUGINS = Path.home() / ".claude" / "plugins"

# Verdict thresholds — keep in sync with docs/verdicts.md
SIZE_BIG_MB = 1.0
UNUSED_DAYS = 30
SIZE_HUGE_MB = 5.0
SIZE_FLOOR_KB = 100


def parse_log(path: Path) -> tuple[Counter, dict[str, datetime]]:
    """Return (counts_by_skill, last_used_by_skill)."""
    counts: Counter = Counter()
    last_used: dict[str, datetime] = {}
    if not path.exists():
        return counts, last_used
    for line in path.read_text(encoding="utf-8", errors="replace").splitlines():
        if "\t" not in line:
            continue
        cols = line.split("\t")
        skill = cols[-1]
        if not skill:
            continue
        counts[skill] += 1
        try:
            ts = datetime.fromisoformat(cols[0].replace("Z", "+00:00"))
        except ValueError:
            continue
        prev = last_used.get(skill)
        if prev is None or ts > prev:
            last_used[skill] = ts
    return counts, last_used


def discover_skills(skills_dir: Path, plugins_dir: Path) -> dict[str, dict]:
    """Map skill name -> {path, size_mb, kind}."""
    found: dict[str, dict] = {}

    if skills_dir.exists():
        for skill_md in skills_dir.rglob("SKILL.md"):
            if not skill_md.is_file():
                continue
            name = skill_md.parent.name
            size_mb = sum(p.stat().st_size for p in skill_md.parent.rglob("*") if p.is_file()) / 1024 / 1024
            found[name] = {"path": skill_md.parent, "size_mb": size_mb, "kind": "user"}

    if plugins_dir.exists():
        for skill_md in plugins_dir.rglob("SKILL.md"):
            if not skill_md.is_file():
                continue
            # Use the immediate parent directory as the skill name; the
            # hook normalizes plugin skill names the same way.
            name = skill_md.parent.name
            if name in found:  # user-skill wins
                continue
            size_mb = sum(p.stat().st_size for p in skill_md.parent.rglob("*") if p.is_file()) / 1024 / 1024
            found[name] = {"path": skill_md.parent, "size_mb": size_mb, "kind": "plugin"}

    return found


def verdict(skill: str, info: dict, counts: Counter, last_used: dict[str, datetime]) -> str:
    n = counts.get(skill, 0)
    size_mb = info["size_mb"]
    last = last_used.get(skill)
    now = datetime.now(timezone.utc)
    unused_days = (now - last).days if last else None

    if n >= 1 and last and (now - last).days <= 7:
        return "保留"
    if size_mb > SIZE_BIG_MB and (unused_days is None or unused_days >= UNUSED_DAYS):
        return "建议卸载"
    if size_mb > SIZE_HUGE_MB and n == 0:
        return "建议卸载"
    if n == 0 and size_mb * 1024 > SIZE_FLOOR_KB:
        return "建议卸载"
    if 0 < n <= 3 and (unused_days is None or unused_days > 14):
        return "保留（询问用户确认）"
    return "保留"


def render(skills: dict[str, dict], counts: Counter, last_used: dict) -> str:
    by_verdict: dict[str, list[tuple[str, dict, int]]] = defaultdict(list)
    for name, info in sorted(skills.items(), key=lambda kv: (-counts.get(kv[0], 0), kv[0])):
        n = counts.get(name, 0)
        by_verdict[verdict(name, info, counts, last_used)].append((name, info, n))

    out: list[str] = []
    out.append("# 技能使用策展报告\n")
    out.append(f"生成时间：{datetime.now(timezone.utc).isoformat(timespec='seconds')}\n")
    out.append("\n## 汇总\n")
    out.append(f"- 已安装技能：{len(skills)}")
    n_used_recently = sum(
        1 for last in last_used.values()
        if (datetime.now(timezone.utc) - last).days <= 30
    )
    out.append(f"- 30 天内被调用过：{n_used_recently}")
    out.append(f"- 建议卸载：{len(by_verdict.get('建议卸载', []))}\n")

    for v in ("建议卸载", "保留（询问用户确认）", "保留"):
        rows = by_verdict.get(v, [])
        if not rows:
            continue
        out.append(f"\n## {v}（{len(rows)}）\n")
        out.append("| 技能 | 类型 | 大小 | 调用次数 | 最后调用 | 路径 |")
        out.append("|------|------|------|----------|----------|------|")
        for name, info, n in rows:
            last = last_used.get(name)
            last_str = last.isoformat(timespec="seconds") if last else "—"
            out.append(f"| {name} | {info['kind']} | {info['size_mb']:.2f} MB | {n} | {last_str} | `{info['path']}` |")
    return "\n".join(out) + "\n"


def main(argv: list[str]) -> int:
    ap = argparse.ArgumentParser(description="Curate Claude Code skill usage.")
    ap.add_argument("--log", type=Path, default=DEFAULT_LOG, help="Path to skill-usage.log")
    ap.add_argument("--skills-dir", type=Path, default=DEFAULT_SKILLS)
    ap.add_argument("--plugins-dir", type=Path, default=DEFAULT_PLUGINS)
    args = ap.parse_args(argv)

    counts, last_used = parse_log(args.log)
    skills = discover_skills(args.skills_dir, args.plugins_dir)
    print(render(skills, counts, last_used))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
